DATABASE_URL=postgresql+psycopg://enterprise_ai_platform:enterprise_ai_platform@127.0.0.1:15432/enterprise_ai_platform
TEST_DATABASE_URL=postgresql+psycopg://enterprise_ai_platform:enterprise_ai_platform@127.0.0.1:15432/enterprise_ai_platform_test
REDIS_URL=
OPENAI_API_KEY=
JWT_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
NEXT_PUBLIC_API_URL=
GITHUB_SYNC_LEDGER_PLANNING_ENABLED=false
# Optional controlled planner target. Supply all six settings or none. The owner
# token is an opaque 32-byte base64url capability; never persist it in source:
# GITHUB_LEDGER_PLANNER_TARGET_ORGANIZATION_ID
# GITHUB_LEDGER_PLANNER_TARGET_CONNECTOR_ID
# GITHUB_LEDGER_PLANNER_TARGET_SCOPE_ID
# GITHUB_LEDGER_PLANNER_TARGET_SYNC_JOB_ID
# GITHUB_LEDGER_CONTROL_RESERVATION_ID
# GITHUB_LEDGER_CONTROL_RESERVATION_OWNER_TOKEN
GITHUB_SYNC_LEDGER_PROCESSING_ENABLED=false
# Optional controlled processor target. Supply all seven settings or none. The
# reservation settings are the same execution-scoped capability used by planner:
# GITHUB_LEDGER_PROCESSOR_TARGET_ORGANIZATION_ID
# GITHUB_LEDGER_PROCESSOR_TARGET_CONNECTOR_ID
# GITHUB_LEDGER_PROCESSOR_TARGET_SCOPE_ID
# GITHUB_LEDGER_PROCESSOR_TARGET_GENERATION_ID
# GITHUB_LEDGER_PROCESSOR_TARGET_WORK_ITEM_ID
# GITHUB_LEDGER_CONTROL_RESERVATION_ID
# GITHUB_LEDGER_CONTROL_RESERVATION_OWNER_TOKEN
GITHUB_SYNC_LEDGER_PROMOTION_ENABLED=false
GITHUB_SYNC_LEDGER_RECONCILIATION_ENABLED=false
GITHUB_LEDGER_PLANNER_MAX_BATCHES=5000
GITHUB_LEDGER_PLANNER_MAX_SECONDS=1200
GITHUB_LEDGER_WORKER_MAX_ITEMS_PER_EXECUTION=25
GITHUB_LEDGER_WORKER_MAX_EXECUTION_SECONDS=1200
GITHUB_LEDGER_WORKER_MINIMUM_CLAIM_SECONDS=720
GITHUB_LEDGER_WORKER_LEASE_SECONDS=900
GITHUB_LEDGER_WORKER_HEARTBEAT_SECONDS=60
GITHUB_LEDGER_WORKER_IDLE_SECONDS=5
GITHUB_LEDGER_WORKER_EMPTY_POLL_LIMIT=1
GITHUB_LEDGER_WORKER_SHUTDOWN_SECONDS=300
GITHUB_LEDGER_WORKER_RECOVERY_LIMIT=10
